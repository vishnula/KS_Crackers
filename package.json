{
  "name": "ks-crackers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "catalogue:template": "node scripts/generate-catalogue-template.mjs",
    "admin:hash": "node scripts/admin-hash.mjs",
    "db:seed": "node scripts/generate-seed.mjs",
    "db:seed:local": "node scripts/generate-seed.mjs && wrangler d1 execute ks-crackers-db --local --file=./seed.sql --yes",
    "db:seed:remote": "node scripts/generate-seed.mjs && wrangler d1 execute ks-crackers-db --remote --file=./seed.sql --yes",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
