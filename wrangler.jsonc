{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ks-crackers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks-crackers-db",
      // Replace with the id printed by: npx wrangler d1 create ks-crackers-db
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  // Holds ISR-rendered pages between revalidations. Free tier is 10 GB.
  // Create it with: npx wrangler r2 bucket create ks-crackers-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ks-crackers-cache"
    }
  ],
  "observability": {
    "enabled": true
  }
}
