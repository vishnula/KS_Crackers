{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ks-crackers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks-crackers-db",
      "database_id": "abd507e9-d8ae-437f-83dc-48818ee2c58c"
    }
  ],
  // Holds ISR-rendered pages between revalidations. KV, not R2, because R2 needs
  // a card on file and nothing here needs object storage until product photos
  // arrive. See open-next.config.ts.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "9bd27b89e62b4a838e3cf0be14244719"
    }
  ],

  // Product photos need R2. Until it is enabled, uploads return a clear "image
  // storage is not connected" error and the rest of the site works unchanged.
  // To turn photos on: enable R2, create the bucket, make it public, then add
  //   "r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "ks-crackers-images" }]
  // and set NEXT_PUBLIC_IMAGE_BASE_URL to the bucket's public URL.
  "observability": {
    "enabled": true
  }
}
